{
    "Java If Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condition}) {",
            "    ${0}",
            "}"
        ],
        "description": "Java if statement"
    },

    "Java If-Else Statement": {
        "prefix": "ifelse",
        "body": [
            "if (${1:condition}) {",
            "    ${2}",
            "} else {",
            "    ${0}",
            "}"
        ],
        "description": "Java if-else statement"
    },

    "Java If-Else-If Statement": {
        "prefix": "ifelseif",
        "body": [
            "if (${1:condition}) {",
            "    ${2}",
            "} else if (${3:condition}) {",
            "    ${4}",
            "} else {",
            "    ${0}",
            "}"
        ],
        "description": "Java if-else-if statement"
    },

    "Java Switch Statement": {
        "prefix": "switch",
        "body": [
            "switch(${1:variable}) {",
            "    case ${2:value}:",
            "        ${3:statements};",
            "        break;",
            "    default:",
            "        ${0}",
            "}"
        ],
        "description": "Java switch statement"
    }
}